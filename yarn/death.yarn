title: death
---
<<if $drac != 1000>>
    <<set $charname to "Dr. h.c. Dr. med. Dr. iur. Dr. phil. Acula">>
<<elseif $witch != 1000>>
    <<set $charname to "Bobo Blocksberg">>
<<elseif $moth != 1000>>
    <<set $charname to "Mothperson">>
<<elseif $fish != 1000>>
    <<set $charname to "Fishy McFishface">>
<<elseif $mum != 1000>>
    <<set $charname to "Muscle Mummy">>
<<endif>>
<<if $charname == "Dr. h.c. Dr. med. Dr. iur. Dr. phil. Acula">>
    <<sprite "drac">>
    <<theme "drac">>
    <<if $drac <= 5>>
        <<if dice(4) == 1>>
            <<jump marry>>
        <<else>>
            <<jump permadeath>>
        <<endif>>
    <<elseif $drac <= 10>>
        <<if dice(6) == 1>>
            <<jump marry>>
        <<else>>
            <<jump permadeath>>
        <<endif>>
    <<elseif $drac <= 15>>
        <<if dice(8) == 1>>
            <<jump marry>>
        <<else>>
            <<jump permadeath>>
        <<endif>>
    <<else>>
        <<if dice(10) == 1>>
            <<jump marry>>
        <<else>>
            <<jump permadeath>>
        <<endif>>
    <<endif>>
<<elseif $charname == "Bobo Blocksberg">>
    <<sprite "witch">>
    <<theme "witch">>
    <<if $witch <= 5>>
        <<if dice(4) == 1>>
            <<jump marry>>
        <<else>>
            <<jump permadeath>>
        <<endif>>
    <<elseif $witch <= 10>>
