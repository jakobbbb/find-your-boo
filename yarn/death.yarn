    <<theme "moth">>
    <<if $moth <= 5>>
        <<if dice(4) == 1>>
            <<jump marry>>
        <<else>>
            <<jump permadeath>>
        <<endif>>
    <<elseif $moth <= 10>>
        <<if dice(6) == 1>>
            <<jump marry>>
        <<else>>
            <<jump permadeath>>
        <<endif>>
    <<elseif $moth <= 15>>
        <<if dice(8) == 1>>
            <<jump marry>>
        <<else>>
            <<jump permadeath>>
        <<endif>>
    <<else>>
        <<if dice(10) == 1>>
            <<jump marry>>
        <<else>>
            <<jump permadeath>>
        <<endif>>
    <<endif>>
<<elseif $charname == "Fishy McFishface">>
    <<sprite "fish">>
    <<theme "fish">>
    <<if $fish <= 5>>
        <<if dice(4) == 1>>
            <<jump marry>>
        <<else>>
            <<jump permadeath>>
        <<endif>>
    <<elseif $fish <= 10>>
        <<if dice(6) == 1>>
            <<jump marry>>
        <<else>>
            <<jump permadeath>>
        <<endif>>
    <<elseif $fish <= 15>>
        <<if dice(8) == 1>>
            <<jump marry>>
        <<else>>
            <<jump permadeath>>
        <<endif>>
    <<else>>
        <<if dice(10) == 1>>
            <<jump marry>>
        <<else>>
