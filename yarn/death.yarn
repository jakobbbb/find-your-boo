        <<else>>
            <<jump permadeath>>
        <<endif>>
    <<else>>
        <<if dice(10) == 1>>
            <<jump marry>>
        <<else>>
            <<jump permadeath>>
        <<endif>>
    <<endif>>
<<elseif $charname == "Mothperson">>
