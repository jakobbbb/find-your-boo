title: death
---
<<if $charname == "Dr. h.c. Dr. med. Dr. iur. Dr. phil. Acula">>
    <<sprite "drac">>
    <<theme "drac">>
    <<if $drac <= 5>>
        <<if dice(4) == 1>>
            <<jump marry>>
        <<else>>
            <<jump permadeath>>
        <<endif>>
    <<elseif $drac <= 10>>
        <<if dice(6) == 1>>
            <<jump marry>>
        <<else>>
            <<jump permadeath>>
        <<endif>>
    <<elseif $drac <= 15>>
        <<if dice(8) == 1>>
            <<jump marry>>
        <<else>>
            <<jump permadeath>>
        <<endif>>
    <<else>>
        <<if dice(10) == 1>>
            <<jump marry>>
        <<else>>
            <<jump permadeath>>
        <<endif>>
    <<endif>>
